# Copy to `.env.local` in this folder and paste your real values.
# Do not commit `.env.local` or put real keys in `.env.example`.

# Required — https://console.anthropic.com/ → API keys
ANTHROPIC_API_KEY=

# Optional — see `app/api/recipe/route.ts` (defaults if unset)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — trained sklearn API (see ml/serve_predict.py). Default http://127.0.0.1:8765
# ML_API_URL=http://127.0.0.1:8765
